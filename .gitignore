# outputs: keep aggregate tables, PNG figures, captions and social; drop heavy exports and logs
outputs/
paper*/outputs/**
!paper*/outputs/
!paper*/outputs/tables/
!paper*/outputs/tables/**
!paper*/outputs/maps/
!paper*/outputs/maps/*.png
!paper*/outputs/maps/captions.md
!paper*/outputs/social/
!paper*/outputs/social/**

demo/raw/
demo/processed/
demo/*.log
demo/outputs/
tests/fixtures/

# Word versions of the manuscript stay local
*.docx
